{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/routes", "destination": "/library", "permanent": true },
    { "source": "/routes/:path*", "destination": "/library", "permanent": true },
    { "source": "/calculators/what-if", "destination": "/calculators", "permanent": true },
    { "source": "/calculators/age-graded", "destination": "/calculators/vma", "permanent": true },
    { "source": "/calculators/equivalence", "destination": "/calculators/vma", "permanent": true },
    { "source": "/calculators/convertisseur", "destination": "/calculators/allures", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(today|activities|favorites|my-zones|profile|settings|quiz|plans|library/weekly|weeks|weeks/new|weeks/shared|weeks/[^/]+|workout/builder|workout/builder/[^/]+|workout/shared|workout/STR-\\d+|plan/new/assisted|plan/new/free|plan/new/mode|plan/shared|plan/[^/]+|race-simulator/shared)", "destination": "/" },
    { "source": "/_en/(today|activities|favorites|my-zones|profile|settings|quiz|plans|library/weekly|weeks|weeks/new|weeks/shared|weeks/[^/]+|workout/builder|workout/builder/[^/]+|workout/shared|workout/STR-\\d+|plan/new/assisted|plan/new/free|plan/new/mode|plan/shared|plan/[^/]+|race-simulator/shared)", "destination": "/" }
  ],
  "routes": [
    {
      "src": "/",
      "has": [{ "type": "query", "key": "lang", "value": "en" }],
      "dest": "/_en"
    },
    {
      "src": "/((?!_en(?:/|$)|spa\\.html$)[^.]*)",
      "has": [{ "type": "query", "key": "lang", "value": "en" }],
      "dest": "/_en/$1"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
