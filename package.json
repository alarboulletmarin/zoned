{
  "name": "zoned",
  "version": "0.7.5",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "alarboulletmarin",
  "description": "Zone-based training workouts, plans and calculators for running, cycling and swimming.",
  "homepage": "https://zoned.run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alarboulletmarin/zoned.git"
  },
  "bugs": {
    "url": "https://github.com/alarboulletmarin/zoned/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && bun run scripts/qa-workout-schema.ts && bun run scripts/generate-icons.ts --check && bun run scripts/generate-sitemap.ts && bun run scripts/generate-licenses.ts && vite build && bun run scripts/generate-route-meta.ts",
    "postinstall": "test -n \"$VERCEL\" || puppeteer browsers install chrome",
    "generate:sitemap": "bun run scripts/generate-sitemap.ts",
    "generate:licenses": "bun run scripts/generate-licenses.ts",
    "generate:og": "bun run scripts/generate-og-image.ts",
    "generate:icons": "bun run scripts/generate-icons.ts",
    "check:icons": "bun run scripts/generate-icons.ts --check",
    "check:workouts": "bun run scripts/qa-workout-schema.ts",
    "demo:gif": "bun run scripts/record-demo.ts",
    "preview": "vite preview",
    "prerender": "bun run scripts/prerender.ts",
    "check:i18n": "bun run scripts/check-i18n-parity.ts",
    "build:seo": "tsc && bun run scripts/generate-icons.ts --check && bun run scripts/generate-licenses.ts && vite build && bun run scripts/generate-sitemap.ts && bun run scripts/prerender.ts",
    "build:seo:full": "bun run scripts/generate-og-image.ts && bun run build:seo",
    "deploy": "bun run build:seo && git add -f dist public/sitemap.xml && git diff --cached --quiet || git commit -m 'chore(build): regenerate prerendered dist'",
    "generate:route-meta": "bun run scripts/generate-route-meta.ts",
    "generate:pwa-screenshots": "bun run scripts/generate-pwa-screenshots.ts"
  },
  "devDependencies": {
    "@material-symbols/svg-600": "^0.45.9",
    "@tailwindcss/vite": "^4.1.18",
    "@types/pdfmake": "^0.2.12",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^5.1.2",
    "playwright": "~1.56.0",
    "puppeteer": "^24.39.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-svgr": "^4.5.0"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.188.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sparticuz/chromium": "^149.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "ics": "^3.8.1",
    "idb-keyval": "^6.2.2",
    "leaflet": "^1.9.4",
    "pdfmake": "^0.3.3",
    "puppeteer-core": "^25.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-body-highlighter": "^2.0.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.75.0",
    "react-i18next": "^16.5.3",
    "react-loading-skeleton": "^3.5.0",
    "react-router-dom": "^7.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3"
  }
}
