# One-off QA harnesses: they generate plans or weeks and print measurements.
# Useful while auditing, not part of the build. Ignoring scripts/ wholesale
# would also swallow the build scripts (sitemap, prerender, i18n check).
scripts/qa-*.ts

# ...except the ones that gate CI and the build. These are contracts, not
# harnesses: a check nobody can run in CI is not a check. The three below were
# committed before the rule above existed and stayed tracked by accident;
# qa-workout-schema.ts would have been swallowed silently.
!scripts/qa-zone-colors.ts
!scripts/qa-zone-audit.ts
!scripts/qa-sync-typical-duration.ts
!scripts/qa-workout-schema.ts
!scripts/qa-workout-schema.test.ts
